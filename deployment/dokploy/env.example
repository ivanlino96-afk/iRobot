# Paste completed values into Dokploy > Environment; never commit real values.
# Use hexadecimal POSTGRES_PASSWORD to keep DATABASE_URL correctly encoded.
POSTGRES_PASSWORD=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
AUTH_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_HEX_CHARACTERS
MQTT_ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET
MQTT_PUBLIC_HOST=mqtt.example.com
AIROBOT_PRIVATE_DIR=/opt/airobot/private
